/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://intel-feed.j6f4q6fhs9.workers.dev; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache
/threat-actors
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache
/*.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache
/*.css
  Content-Type: text/css; charset=utf-8
/*.js
  Content-Type: text/javascript; charset=utf-8
/*.svg
  Content-Type: image/svg+xml
/*.jpg
  Content-Type: image/jpeg
/*.png
  Content-Type: image/png
/*.webp
  Content-Type: image/webp
/*.ico
  Content-Type: image/x-icon
